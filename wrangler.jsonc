{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flower-subconvert",
  "main": "./worker.js",
  "compatibility_date": "2026-08-27",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/sub", "/sub/*"]
  },
  "kv_namespaces": [
    {
      "binding": "TOKENS",
      "id": "27ef6c733c794185a0c3518ef83b93dc"
    }
  ]
}
