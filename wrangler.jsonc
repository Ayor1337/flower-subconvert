{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flower-subconvert",
  "main": "./worker.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "npm run build"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/sub", "/sub/*"]
  },
  "d1_databases": [
    {
      "binding": "HISTORY_DB",
      "database_name": "flower-sub-history",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TOKENS",
      "id": "27ef6c733c794185a0c3518ef83b93dc"
    }
  ]
}
