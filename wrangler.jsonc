{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flower-subconvert",
  "main": "./worker.js",
  "compatibility_date": "2026-08-27",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/sub", "/sub/*"]
  }
}
